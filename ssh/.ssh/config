# Managed via dotfiles/ssh (stow). Private keys are NOT in the repo — copy
# ~/.ssh/id_github (and its .pub) onto a new machine manually.
#
# The ssh-agent runs as a `systemctl --user` service (ssh-agent.service), and
# SSH_AUTH_SOCK is exported session-wide via ~/.config/environment.d. With
# AddKeysToAgent below, the key is added to the agent automatically on first
# use, so the passphrase is asked once per login instead of every session.

Host github.com
    User git
    IdentityFile ~/.ssh/id_github
    IdentitiesOnly yes

Host *
    AddKeysToAgent yes
